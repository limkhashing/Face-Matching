{
  "version": 2,
  "builds": [
    {
      "src": "*.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "Dockerfile",
      "use": "@vercel/docker"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/app"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app"
    }
  ]
}
